# Optional PowerShell configuration (env files are not automatically loaded):
# $env:CLOCKWORK_DB_PATH = 'data/clockwork.sqlite3'
# Relative database paths always resolve from the ClockWork project root.
CLOCKWORK_DB_PATH=data/clockwork.sqlite3

# Supabase backend PostgreSQL connection. Takes precedence over CLOCKWORK_DB_PATH.
# Copy the session-pooler URL from Supabase Connect; URL-encode the password.
# Set in the server's PowerShell environment; this file is not auto-loaded.
# CLOCKWORK_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Backend tables live in private schema clockwork, not public or Supabase Auth.

# Exact browser origins allowed for login/logout. No wildcard or CORS grants.
CLOCKWORK_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001
# false is for this loopback HTTP demonstration only. Use true with HTTPS.
CLOCKWORK_COOKIE_SECURE=false

# MongoDB runtime settings are in backend/.env.example.
