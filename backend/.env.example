# New MongoDB ClockWork runtime (backend.app.main:app), separate from legacy SQL.
# Set these in the shell; env files are not loaded automatically.
CW_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
CW_MONGO_DATABASE=clockwork_demo_local
CW_MODE=demo
CW_COOKIE_SECURE=false
CW_SESSION_MINUTES=60
CW_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CW_BUSINESS_TIMEZONE=Asia/Kolkata
